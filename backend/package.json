{
  "name": "wink-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.mock.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:glasses": "node tools/build-glasses.mjs",
    "deploy": "wrangler deploy",
    "dev:real": "wrangler dev",
    "smoke": "node test/smoke.mjs",
    "copy:snowflake": "node --env-file-if-exists=.dev.vars --import tsx tools/copy-snowflake-memories.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "three": "0.180.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0"
  }
}
