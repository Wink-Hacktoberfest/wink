{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wink-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  // No AI binding: the demo must run without a Cloudflare account or remote proxy.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/v1/*"]
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "wink-images" }],
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "vars": { "MOCK": "true" }
}
