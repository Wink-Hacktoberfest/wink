{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wink-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  // The TV dashboard is static: /tv serves public/tv/index.html. The Worker always runs first for /v1/*.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/v1/*"]
  },
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "wink-images" }
  ],
  // One shared room: the TV and the glasses meet in a single LiveRoom instance.
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }
  ],
  // Fallback vision only (VISION_PROVIDER="workers-ai" or VISION_MODEL empty).
  "ai": { "binding": "AI" },
  "vars": {
    "MOCK": "true",
    "CHAT_MODEL": "openai-gpt-oss-120b",
    "VISION_PROVIDER": "digitalocean",
    "VISION_MODEL": "",
    "WORKERS_AI_VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "EMBED_MODEL": "snowflake-arctic-embed-l-v2.0",
    "SNOWFLAKE_ACCOUNT_URL": "",
    "SNOWFLAKE_WAREHOUSE": "WINK_WH",
    "SNOWFLAKE_DATABASE": "WINK",
    "SNOWFLAKE_SCHEMA": "APP",
    "SNOWFLAKE_ROLE": "",
    "OVERTURE_PLACES_TABLE": "OVERTURE_MAPS__PLACES.CARTO.PLACE",
    "DEMO_LAT": "",
    "DEMO_LNG": ""
  }
  // Secrets (never here): WINK_TOKEN, DO_MODEL_ACCESS_KEY, SNOWFLAKE_PAT. See .dev.vars.example.
}
